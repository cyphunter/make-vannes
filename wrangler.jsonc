{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "make",
  "main": ".open-next/worker.js",
  "compatibility_date": "2025-05-05",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "workers_dev": true,

  "assets": {
    "binding": "ASSETS",
    "directory": ".open-next/assets"
  },

  "observability": {
    "enabled": true
  },

  // ─── R2 (médias boutique, ateliers, créateurs) ───────────────────────
  // ⚠️ Désactivé pour V1 (site showcase, images en /public). Pour activer :
  //  1. wrangler r2 bucket create make-media
  //  2. décommenter le bloc r2_buckets ci-dessous
  // "r2_buckets": [
  //   {
  //     "binding": "MEDIA_BUCKET",
  //     "bucket_name": "make-media"
  //   }
  // ],

  // ─── KV (cache court / anti-flood formulaire) ────────────────────────
  // ⚠️ Désactivé pour V1 (pas d'usage côté code actuellement). Pour activer :
  //  1. wrangler kv namespace create make-kv
  //  2. copier l'ID retourné dans `id` ci-dessous
  //  3. décommenter le bloc kv_namespaces
  // "kv_namespaces": [
  //   {
  //     "binding": "KV",
  //     "id": "TODO_REPLACE_WITH_REAL_KV_ID"
  //   }
  // ],

  // ─── Vars publiques ──────────────────────────────────────────────────
  // SITE_ID = "make" — réservé en cas d'ajout futur de DB partagée
  "vars": {
    "NEXT_PUBLIC_SITE_URL": "https://makevannes.com",
    "SITE_ID": "make",
    "CONTACT_TO_EMAIL": "contact@makevannes.com"
  }

  // ─── Aucun secret requis en V1 ───────────────────────────────────────
  // Contact = mailto + tel direct, pas d'envoi email transactionnel.

  // ─── PAS de D1 ni d'auth : site showcase pur ─────────────────────────
}
